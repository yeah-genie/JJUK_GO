{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "docs/prototype",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"data\" ] && exit 0 || exit 1",
  "git": {
    "deploymentEnabled": {
      "data": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/signal-live.js": {
      "includeFiles": "config/live_signals.json"
    }
  },
  "rewrites": [
    {
      "source": "/classic",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/reference-ui/",
      "permanent": false
    }
  ]
}
