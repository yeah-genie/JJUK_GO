+/* 걷기: 위 안내 판을 결과 머리와 같은 형식으로 */
+#s-walk .next{min-height:0;padding:max(12px,env(safe-area-inset-top)) 20px 16px;border:0;border-radius:0 0 var(--r-l) var(--r-l);box-shadow:var(--panel-shadow)}
