-
-.sig-legend{flex-wrap:nowrap;gap:9px;padding:5px 9px;font-size:11px;white-space:nowrap;overflow:hidden;bottom:calc(var(--sheet-h) + 30px);right:auto;max-width:calc(100% - 20px)}
-.sig-legend .lg{width:10px;height:10px}.sig-legend .lg-src{margin-left:2px}
-.rtab .rc-top{height:22px;min-height:22px}
-@media(max-height:700px){.rtabs{margin:6px 0 8px}.rtab{min-height:0;padding:9px 10px;gap:4px}.rtab .mins{font-size:24px;line-height:28px}.rtab .rc-row.pro~.rc-row.pro{display:none}.rhead{font-size:18px;margin:4px 0}}
+.rtab .rc-row.pro .mi{color:var(--lane)}
+.rtab .rc-row.con{color:var(--muted)}
+#result-footer{padding:8px 16px max(16px,env(safe-area-inset-bottom))}
+.btn-walk{gap:8px;height:52px;min-height:52px;border-radius:var(--r-s);font-size:17px;font-weight:700}.btn-walk .ico{width:22px;height:22px}
